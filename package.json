{
  "name": "morfesu-website-definitive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:public-assets": "node scripts/check-public-assets.mjs",
    "check:public-assets:strict": "node scripts/check-public-assets.mjs --strict",
    "check:env": "node scripts/check-env.mjs",
    "check:env:strict": "node scripts/check-env.mjs --strict",
    "report:health": "node scripts/report-health.mjs",
    "prepare": "husky",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@tabler/icons-webfont": "^3.44.0",
    "framer-motion": "^12.35.0",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.18",
    "marked": "^18.0.5",
    "next": "16.2.11",
    "next-intl": "^4.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "schema-dts": "^2.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "lint-staged": {
    "*.{md,css,yml,yaml}": "prettier --write"
  }
}
